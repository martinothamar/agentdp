prefix_rule(
    pattern = ["git", "add"],
    decision = "allow",
    justification = "Allow staging explicitly selected files for commits.",
    match = ["git add"],
)

prefix_rule(
    pattern = ["git", "commit"],
    decision = "allow",
    justification = "Allow creating local git commits from staged changes.",
    match = ["git commit"],
)

prefix_rule(
    pattern = ["git", "mv"],
    decision = "allow",
    justification = "Allow tracked file and crate moves during refactors.",
    match = ["git mv"],
)

prefix_rule(
    pattern = ["New-Item", "-ItemType", "Directory"],
    decision = "allow",
    justification = "Allow creating target directories for repo-local refactors.",
    match = ["New-Item -ItemType Directory"],
)

prefix_rule(
    pattern = ["rg"],
    decision = "allow",
    justification = "Allow read-only repository searches during development.",
    match = ["rg"],
)

prefix_rule(
    pattern = ["make", ["fmt", "lint", "build", "test", "deps", "install"]],
    decision = "allow",
    justification = "Allow routine repo formatting, linting, building, testing, dependency review, and user-local install targets.",
    match = ["make fmt", "make lint", "make build", "make test", "make deps", "make install"],
)

prefix_rule(
    pattern = ["just", ["default", "fmt", "lint", "build", "test", "test-e2e", "coverage-network", "test-e2e-network", "wsl_fmt", "wsl_lint", "wsl_build", "wsl_test", "wsl_test_e2e", "deps", "prepare-guest-tools", "install", "setup", "fuzz-smoke", "fuzz-network-smoke", "mutants"]],
    decision = "allow",
    justification = "Allow routine repo formatting, linting, building, testing, dependency review, and user-local install targets.",
    match = [
        "just default",
        "just fmt",
        "just lint",
        "just build",
        "just test",
        "just test-e2e",
        "just coverage-network",
        "just test-e2e-network",
        "just wsl_fmt",
        "just wsl_lint",
        "just wsl_build",
        "just wsl_test",
        "just wsl_test_e2e",
        "just deps",
        "just prepare-guest-tools",
        "just install",
        "just setup",
        "just fuzz-smoke",
        "just fuzz-network-smoke",
        "just mutants",
    ],
)

prefix_rule(
    pattern = ["cargo", "fmt"],
    decision = "allow",
    justification = "Allow Rust formatting checks and formatting for this workspace.",
    match = ["cargo fmt", "cargo fmt --all", "cargo fmt --all --check"],
)

prefix_rule(
    pattern = ["cargo", "clippy"],
    decision = "allow",
    justification = "Allow Rust linting for this workspace.",
    match = ["cargo clippy", "cargo clippy --workspace --all-targets"],
)

prefix_rule(
    pattern = ["cargo", "build"],
    decision = "allow",
    justification = "Allow Rust builds for this workspace.",
    match = ["cargo build", "cargo build --workspace", "cargo build --release -p agentdp-cli"],
)

prefix_rule(
    pattern = ["cargo", "nextest", "run"],
    decision = "allow",
    justification = "Allow Rust tests through cargo-nextest for this workspace.",
    match = ["cargo nextest run", "cargo nextest run --workspace"],
)

prefix_rule(
    pattern = ["cargo", "tree"],
    decision = "allow",
    justification = "Allow Rust dependency tree review for this workspace.",
    match = ["cargo tree", "cargo tree --workspace"],
)

prefix_rule(
    pattern = ["target/release/agentctl", "self", "install"],
    decision = "allow",
    justification = "Allow the release-built agentctl binary to install itself for the current user.",
    match = ["target/release/agentctl self install"],
)

prefix_rule(
    pattern = ["agentctl", ["create", "clone", "status", "up", "down", "rm", "exec", "logs", "ps", "shell", "doctor", "manifest", "self"]],
    decision = "allow",
    justification = "Allow routine installed agentctl commands.",
    match = [
        "agentctl create",
        "agentctl clone",
        "agentctl status",
        "agentctl up",
        "agentctl down",
        "agentctl rm",
        "agentctl exec",
        "agentctl logs",
        "agentctl ps",
        "agentctl shell",
        "agentctl doctor",
        "agentctl manifest",
        "agentctl self",
    ],
)

prefix_rule(
    pattern = ["agentctl", "-v", ["create", "clone", "status", "up", "down", "rm", "exec", "logs", "ps", "shell", "doctor", "manifest", "self"]],
    decision = "allow",
    justification = "Allow routine installed agentctl commands when the global verbose flag is used before the subcommand.",
    match = [
        "agentctl -v create",
        "agentctl -v clone",
        "agentctl -v status",
        "agentctl -v up",
        "agentctl -v down",
        "agentctl -v rm",
        "agentctl -v exec",
        "agentctl -v logs",
        "agentctl -v ps",
        "agentctl -v shell",
        "agentctl -v doctor",
        "agentctl -v manifest",
        "agentctl -v self",
    ],
)
