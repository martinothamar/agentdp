# Copy this shape to .env and fill values locally when using plugin copy/env auth.
# Plugin-owned names are copied or mediated according to agent.yaml auth settings.

GITHUB_TOKEN=
GH_TOKEN=
GITHUB_PAT=

GIT_USER_NAME=
GIT_USER_EMAIL=

# Only needed for codex auth_source: env. The normal host-auth source uses ~/.codex/auth.json.
OPENAI_API_KEY=
CODEX_API_KEY=

STUDIO_DEV_API_KEY=
STUDIO_STAGING_API_KEY=
STUDIO_PROD_API_KEY=
