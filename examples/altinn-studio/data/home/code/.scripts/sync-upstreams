#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: sync-upstreams [options] [repo-or-path ...]

Sync direct child git repositories in the code folder from main/master.
When repo-or-path arguments are provided, sync only those repositories.

Default behavior:
  - scans only direct child directories of the code directory
  - fetches direct repositories from origin
  - fetches forked repositories from upstream and syncs the fork's origin
  - prefers main, falls back to master
  - fast-forwards the local branch too when it exists and the worktree is clean
  - skips divergent forks instead of rewriting history

Options:
  --dry-run              Show what would be pushed without changing remotes
  --force-with-lease     Allow updating divergent origin branches
  --include-dirty-local  Allow local branch fast-forward checks in dirty worktrees
  -h, --help             Show this help

Examples:
  sync-upstreams
  sync-upstreams --dry-run altinn-studio
  sync-upstreams ../code/altinn-studio-docs /data/home/code/app-lib-dotnet
EOF
}

dry_run=false
force_with_lease=false
include_dirty_local=false
repo_args=()

for arg in "$@"; do
  case "$arg" in
    --dry-run)
      dry_run=true
      ;;
    --force-with-lease)
      force_with_lease=true
      ;;
    --include-dirty-local)
      include_dirty_local=true
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      echo "Unknown option: $arg" >&2
      usage >&2
      exit 2
      ;;
    *)
      repo_args+=("$arg")
      ;;
  esac
done

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
code_dir="$(cd "$script_dir/.." && pwd)"

ok=0
skipped=0
failed=0

has_remote() {
  local repo=$1
  local remote=$2
  git -C "$repo" remote get-url "$remote" >/dev/null 2>&1
}

ref_exists() {
  local repo=$1
  local ref=$2
  git -C "$repo" show-ref --verify --quiet "$ref"
}

is_ancestor() {
  local repo=$1
  local older=$2
  local newer=$3
  git -C "$repo" merge-base --is-ancestor "$older" "$newer"
}

is_dirty() {
  local repo=$1
  [[ -n "$(git -C "$repo" status --porcelain)" ]]
}

current_branch() {
  local repo=$1
  git -C "$repo" symbolic-ref --quiet --short HEAD 2>/dev/null || true
}

is_git_worktree() {
  local repo=$1
  git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1
}

normalize_dir() {
  local path=$1
  (cd "$path" && pwd)
}

resolve_repo_arg() {
  local arg=$1
  local candidate

  if [[ "$arg" == /* ]]; then
    candidate=$arg
  elif [[ -e "$PWD/$arg" ]]; then
    candidate="$PWD/$arg"
  else
    candidate="$code_dir/$arg"
  fi

  if [[ ! -d "$candidate" ]]; then
    echo "Argument is not a directory: $arg" >&2
    return 1
  fi

  candidate="$(normalize_dir "$candidate")"
  if ! is_git_worktree "$candidate"; then
    echo "Argument is not a git repository: $arg" >&2
    return 1
  fi

  printf '%s\n' "$candidate"
}

sync_repo() {
  local repo=$1
  local name
  local branch=
  local checked_out_branch
  local source_remote
  local source_ref
  local origin_ref
  local local_branch_ref
  local push_args=()
  local forked=false

  name="$(basename "$repo")"
  echo "==> $name"

  if ! has_remote "$repo" origin; then
    echo "    skip: missing origin remote"
    skipped=$((skipped + 1))
    return
  fi

  git -C "$repo" fetch --prune --quiet origin || return 1
  source_remote=origin
  if has_remote "$repo" upstream; then
    git -C "$repo" fetch --prune --quiet upstream || return 1
    source_remote=upstream
    forked=true
  fi

  if ref_exists "$repo" "refs/remotes/$source_remote/main"; then
    branch=main
  elif ref_exists "$repo" "refs/remotes/$source_remote/master"; then
    branch=master
  else
    echo "    skip: $source_remote has neither main nor master"
    skipped=$((skipped + 1))
    return
  fi

  source_ref="refs/remotes/$source_remote/$branch"
  origin_ref="refs/remotes/origin/$branch"
  local_branch_ref="refs/heads/$branch"

  if [[ "$forked" == true ]] && ref_exists "$repo" "$origin_ref"; then
    if ! is_ancestor "$repo" "$origin_ref" "$source_ref"; then
      if [[ "$force_with_lease" == true ]]; then
        push_args+=(--force-with-lease="refs/heads/$branch:$(git -C "$repo" rev-parse "$origin_ref")")
      else
        echo "    skip: origin/$branch has commits not in upstream/$branch; rerun with --force-with-lease to overwrite the fork branch"
        skipped=$((skipped + 1))
        return
      fi
    fi
  fi

  if ref_exists "$repo" "$local_branch_ref"; then
    checked_out_branch="$(current_branch "$repo")"
    if [[ "$include_dirty_local" == true ]] || ! is_dirty "$repo"; then
      if is_ancestor "$repo" "$local_branch_ref" "$source_ref"; then
        if [[ "$dry_run" == true ]]; then
          echo "    dry-run: local $branch -> $source_remote/$branch"
        else
          if [[ "$checked_out_branch" == "$branch" ]]; then
            git -C "$repo" merge --ff-only "$source_ref" >/dev/null || return 1
          else
            git -C "$repo" branch --force "$branch" "$source_ref" >/dev/null || return 1
          fi
          echo "    local $branch -> $source_remote/$branch"
        fi
      else
        echo "    local $branch not moved: it has commits not in $source_remote/$branch"
      fi
    else
      echo "    local $branch not moved: dirty worktree"
    fi
  fi

  if [[ "$forked" == true ]]; then
    if [[ "$dry_run" == true ]]; then
      echo "    dry-run: git push origin $source_ref:refs/heads/$branch"
    else
      git -C "$repo" push "${push_args[@]}" origin "$source_ref:refs/heads/$branch" || return 1
    fi
  fi

  echo "    synced $branch from $source_remote"
  ok=$((ok + 1))
}

if (( ${#repo_args[@]} > 0 )); then
  for repo_arg in "${repo_args[@]}"; do
    if candidate="$(resolve_repo_arg "$repo_arg")"; then
      if ! sync_repo "$candidate"; then
        echo "    failed"
        failed=$((failed + 1))
      fi
    else
      failed=$((failed + 1))
    fi
  done
else
  for candidate in "$code_dir"/*; do
    [[ -d "$candidate/.git" ]] || continue
    if ! sync_repo "$candidate"; then
      echo "    failed"
      failed=$((failed + 1))
    fi
  done
fi

if (( ok == 0 && skipped == 0 && failed == 0 )); then
  echo "No repositories found."
  failed=1
fi

echo
echo "Summary: synced=$ok skipped=$skipped failed=$failed"

if (( failed > 0 )); then
  exit 1
fi
