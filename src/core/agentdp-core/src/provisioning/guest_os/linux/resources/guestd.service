[Unit]
Description=agentdp guest helper daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=AGENTDP_STATE_DIR=%h/.local/state/agentdp
Environment=AGENTDP_PR_REGISTRY=%h/.local/state/agentdp/pr-watch.json
Environment=AGENTDP_AGENT_PANE_FILE=%h/.local/state/agentdp/agent-pane-id
ExecStart=/usr/local/bin/agentdp-agent-env /usr/local/bin/guestd
Restart=always
RestartSec=20

[Install]
WantedBy=default.target
