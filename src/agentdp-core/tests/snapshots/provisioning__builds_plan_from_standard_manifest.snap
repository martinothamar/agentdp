image: Archlinux X86_64 Cloud
packages: git, sudo, docker, docker-compose, docker-buildx, mise, npm, github-cli, curl
groups: docker
repos:
  https://github.com/martinothamar-agent/altinn-studio.git -> altinn-studio
healthchecks:
  code-server: tcp 127.0.0.1:4090 timeout=60s
  docker: command docker ps timeout=60s
--- meta-data
instance-id: altinn-studio
local-hostname: altinn-studio
--- user-data
#cloud-config
package_update: true
packages:
- git
- sudo
- docker
- docker-compose
- docker-buildx
- mise
- npm
- github-cli
- curl
users:
- default
- name: agent
  homedir: /data/home
  sudo: ALL=(ALL) NOPASSWD:ALL
  shell: /bin/bash
write_files:
- path: /opt/agentdp/bootstrap.sh
  permissions: '0755'
  content: |
    #!/usr/bin/env bash
    set -euo pipefail
    AGENTDP_USER='agent'
    AGENTDP_HOME='/data/home'
    AGENTDP_CODE_DIR='/data/home/code'
    AGENTDP_AGENT_ENV=/usr/local/bin/agentdp-agent-env
    export HOME="${HOME:-/root}"
    export PATH="/usr/local/bin:/usr/bin:/bin:$PATH"
    mkdir -p "$AGENTDP_HOME" "$AGENTDP_CODE_DIR"
    chown -R "$AGENTDP_USER:$AGENTDP_USER" "$AGENTDP_HOME"

    if command -v systemctl >/dev/null 2>&1 && systemctl list-unit-files sshd.service >/dev/null 2>&1; then
      systemctl enable --now sshd.service
    fi

    install -d -m 0755 "$(dirname "$AGENTDP_AGENT_ENV")"
    cat >"$AGENTDP_AGENT_ENV" <<'EOF'
    #!/usr/bin/env sh
    export HOME='/data/home'
    export AGENTDP_HOME='/data/home'
    export AGENTDP_CODE_DIR='/data/home/code'
    export PATH="/usr/local/bin:/usr/bin:/bin${PATH:+:$PATH}"
    if [ -r /etc/profile.d/agentdp-agent.sh ]; then
      . /etc/profile.d/agentdp-agent.sh
    fi
    exec "$@"
    EOF
    chmod 0755 "$AGENTDP_AGENT_ENV"
    cat >"/etc/profile.d/agentdp-agent.sh" <<'EOF'
    if [ "${HOME:-}" = "/data/home" ] || [ "${USER:-}" = "agent" ]; then
      export AGENTDP_HOME='/data/home'
      export AGENTDP_CODE_DIR='/data/home/code'

      agentdp_prepend_path() {
        case ":${PATH:-}:" in
          *":$1:"*) ;;
          *) PATH="$1${PATH:+:$PATH}" ;;
        esac
      }

      agentdp_prepend_path "/opt/mise/shims"
      agentdp_prepend_path "/data/home/.cargo/bin"
      agentdp_prepend_path "/data/home/go/bin"
      agentdp_prepend_path "/data/home/.local/share/mise/shims"
      agentdp_prepend_path "/data/home/.local/bin"
      export PATH
      unset -f agentdp_prepend_path
    fi
    EOF
    chmod 0644 "/etc/profile.d/agentdp-agent.sh"

    if getent group 'docker' >/dev/null 2>&1 && id "$AGENTDP_USER" >/dev/null 2>&1; then
      usermod -aG 'docker' "$AGENTDP_USER"
    fi

    if command -v sudo >/dev/null 2>&1; then
      install -d -m 0750 /etc/sudoers.d
      printf '%s ALL=(ALL) NOPASSWD:ALL\n' "$AGENTDP_USER" >/etc/sudoers.d/agentdp-agent
      chmod 0440 /etc/sudoers.d/agentdp-agent
    fi

    run_agent() {
      local command=$1
      runuser -u "$AGENTDP_USER" --preserve-environment -- "$AGENTDP_AGENT_ENV" bash -lc "$command"
    }

    run_agent_args() {
      runuser -u "$AGENTDP_USER" --preserve-environment -- "$AGENTDP_AGENT_ENV" "$@"
    }

    clone_repo() {
      local url=$1
      local path=$2
      for attempt in $(seq 1 6); do
        run_agent_args git clone "$url" "$path" && return 0
        sleep $((attempt * 2))
      done
      run_agent_args git clone "$url" "$path"
    }

    target="$AGENTDP_HOME/.codex/AGENTS.md"
    start="<!-- agentdp-info:start -->"
    end="<!-- agentdp-info:end -->"
    tmp="$(mktemp)"
    install -d -o "$AGENTDP_USER" -g "$AGENTDP_USER" -m 0755 "$(dirname "$target")"
    touch "$target"
    chown "$AGENTDP_USER:$AGENTDP_USER" "$target"
    awk -v start="$start" -v end="$end" '
      $0 == start { skip = 1; next }
      $0 == end { skip = 0; next }
      !skip { print }
    ' "$target" >"$tmp"
    {
      cat "$tmp"
      if [ -s "$tmp" ]; then printf '\n'; fi
      printf '%s\n' "$start"
      cat <<'AGENTDP_INFO_B64' | base64 -d
    
    AGENTDP_INFO_B64
      printf '%s\n' "$end"
    } >"$target"
    chown "$AGENTDP_USER:$AGENTDP_USER" "$target"
    rm -f "$tmp"

    if command -v systemctl >/dev/null 2>&1 && systemctl list-unit-files docker.service >/dev/null 2>&1; then
      systemctl enable --now docker.service
    fi
    if ! command -v code-server >/dev/null 2>&1; then
      curl -fsSL https://code-server.dev/install.sh | sh -s -- --method=standalone --prefix=/usr/local
    fi
    cat >/etc/systemd/system/code-server.service <<'EOF'
    [Unit]
    Description=agentdp code-server
    After=network-online.target
    Wants=network-online.target

    [Service]
    User=agent
    Group=agent
    WorkingDirectory=/data/home/code
    ExecStart=/usr/local/bin/agentdp-agent-env /usr/local/bin/code-server --bind-addr 0.0.0.0:4090 --auth none /data/home/code
    Restart=always
    RestartSec=2

    [Install]
    WantedBy=multi-user.target
    EOF
    systemctl daemon-reload
    systemctl enable --now code-server.service
    chown -R "$AGENTDP_USER:$AGENTDP_USER" "$AGENTDP_HOME"

    AGENTDP_CUSTOM_BOOTSTRAP='/run/agentdp/bootstrap.sh'
    AGENTDP_CUSTOM_ENV='/run/agentdp/.env'
    cleanup_agentdp_custom_env() {
      rm -f "$AGENTDP_CUSTOM_ENV"
    }
    trap cleanup_agentdp_custom_env EXIT
    if [ -f "$AGENTDP_CUSTOM_BOOTSTRAP" ]; then
      if [ -f "$AGENTDP_CUSTOM_ENV" ]; then
        set -a
        # shellcheck source=/dev/null
        . "$AGENTDP_CUSTOM_ENV"
        set +a
      fi
      . "$AGENTDP_CUSTOM_BOOTSTRAP"
    fi
    cleanup_agentdp_custom_env
    trap - EXIT

    target="$AGENTDP_CODE_DIR/altinn-studio"
    mkdir -p "$(dirname "$target")"
    chown -R "$AGENTDP_USER:$AGENTDP_USER" "$(dirname "$target")"
    if [ ! -d "$target/.git" ]; then
      clone_repo 'https://github.com/martinothamar-agent/altinn-studio.git' "$target"
    fi
    run_agent_args git -C "$target" config core.preloadIndex true
    run_agent_args git -C "$target" config core.untrackedCache true
    run_agent_args git -C "$target" update-index --test-untracked-cache >/dev/null 2>&1 || true

    run_agent 'if command -v mise >/dev/null 2>&1; then
      mise use --global '"'"'node@lts'"'"'
    fi'
    run_agent 'if [ ! -x "$HOME/.local/share/agentdp/codex/bin/codex" ]; then npm install -g --prefix "$HOME/.local/share/agentdp/codex" @openai/codex@latest; fi'
    run_agent 'install -d -m 0755 "$HOME/.local/bin"
    cat >"$HOME/.local/bin/codex" <<'"'"'EOF'"'"'
    #!/usr/bin/env bash
    set -euo pipefail

    codex_real="$HOME/.local/share/agentdp/codex/bin/codex"
    if [ ! -x "$codex_real" ]; then
      echo "agentdp codex wrapper could not find $codex_real" >&2
      exit 127
    fi
    exec "$codex_real" --sandbox danger-full-access --ask-for-approval never "$@"
    EOF
    chmod 0755 "$HOME/.local/bin/codex"'
    run_agent 'if [ -f "$HOME/.config/gh/hosts.yml" ]; then gh auth setup-git >/dev/null || true; fi'
    run_agent 'code-server --install-extension '"'"'redhat.vscode-yaml'"'"' || true'
    run_agent 'npm install -g playwright'
runcmd:
- - bash
  - /opt/agentdp/bootstrap.sh
